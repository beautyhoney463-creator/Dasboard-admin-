                            <div class="stat-label">Total Rekening</div>
                        </div>
                        <div class="stat-box">
                            <div class="stat-icon">📈</div>
                            <div class="stat-value" id="dashTotalSetoran">Rp 2.5M</div>
                            <div class="stat-label">Total Setoran</div>
                        </div>
                        <div class="stat-box">
                            <div class="stat-icon">⏰</div>
                            <div class="stat-value" id="dashTodayRegis">15</div>
                            <div class="stat-label">Pendaftaran Hari Ini</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Nasabah Section -->
            <div id="nasabah" class="content-section">
                <div class="content-header">
                    <h2>👥 Data Nasabah</h2>
                </div>
                <div class="content-body">
                    <div class="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>No</th>
                                    <th>ID Nasabah</th>
                                    <th>Nama</th>
                                    <th>KTP</th>
                                    <th>Telepon</th>
                                    <th>Status</th>
                                    <th>Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="nasabahTable">
                                <!-- Data akan di-generate oleh JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Rekening Section -->
            <div id="rekening" class="content-section">
                <div class="content-header">
                    <h2>💳 Data Rekening</h2>
                </div>
                <div class="content-body">
                    <div class="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>ID Rekening</th>
                                    <th>Nasabah</th>
                                    <th>Setoran Awal</th>
                                    <th>Tanggal</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody id="rekeningTable">
                                <!-- Data akan di-generate oleh JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Detail Modal -->
    <div id="detailModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="modalTitle">Detail Nasabah</h2>
            </div>
            <div class="modal-body" id="modalBody">
                <!-- Detail content akan diisi oleh JS -->
            </div>
            <div style="padding: 20px; border-top: 1px solid #eee; text-align: right;">
                <button class="btn btn-primary" onclick="closeModal()">Tutup</button>
            </div>
        </div>
    </div>

