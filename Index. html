                        <td>${nasabah.nama}</td>
                        <td>${nasabah.ktp}</td>
                        <td>${nasabah.telepon}</td>
                        <td><span class="status ${nasabah.status}">${nasabah.status.toUpperCase()}</span></td>
                        <td>
                            <button class="btn btn-primary" onclick="showDetail(${index})" style="padding: 8px 15px; font-size: 12px;">Detail</button>
                            ${nasabah.status === 'pending' ? 
                                `<button class="btn btn-success" onclick="approveNasabah(${index})" style="padding: 8px 15px; font-size: 12px; margin-left: 5px;">Approve</button>` : ''
                            }
                        </td>
                    </tr>
                `;
                tbody.innerHTML += row;
            });
        }

        // Generate rekening table
        function generateRekeningTable() {
            const tbody = document.getElementById('rekeningTable');
            tbody.innerHTML = '';
            
            nasabahData.forEach((nasabah, index) => {
                const row = `
                    <tr>
                        <td>REK-${nasabah.id.slice(-3)}</td>
                        <td>${nasabah.nama}</td>
                        <td>Rp ${nasabah.setoran_awal.toLocaleString('id-ID')}</td>
                        <td>${nasabah.tanggal}</td>
                        <td><span class="status ${nasabah.status}">${nasabah.status.toUpperCase()}</span></td>
                    </tr>
                `;
                tbody.innerHTML += row;
            });
        }

