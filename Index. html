<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard Admin - Bank Digital</title>

<style>
* { margin:0; padding:0; box-sizing:border-box; }

body {
    font-family: Arial;
    background: linear-gradient(135deg,#1e3c72,#2a5298);
}

/* Sidebar */
.sidebar {
    position: fixed;
    width: 250px;
    height: 100%;
    background: #333;
    color: white;
    padding: 20px;
}

.nav-item {
    display:block;
    padding:10px;
    margin:5px 0;
    cursor:pointer;
}

.nav-item.active { background:#4CAF50; }

/* Content */
.main {
    margin-left:250px;
    padding:20px;
}

.content-section { display:none; }
.content-section.active { display:block; }

/* Table */
table {
    width:100%;
    border-collapse: collapse;
    background:white;
}

th, td {
    padding:10px;
    border:1px solid #ddd;
}

/* Button */
.btn {
    padding:5px 10px;
    border:none;
    cursor:pointer;
}

.btn-primary { background:blue; color:white; }
.btn-success { background:green; color:white; }

/* Modal */
.modal {
    display:none;
    position:fixed;
    top:0; left:0;
    width:100%; height:100%;
    background:rgba(0,0,0,0.5);
}

.modal-content {
    background:white;
    margin:10% auto;
    padding:20px;
    width:400px;
}
</style>
</head>

<body>

<div class="sidebar">
    <div class="nav-item active" onclick="showSection('dashboard', event)">Dashboard</div>
    <div class="nav-item" onclick="showSection('nasabah', event)">Nasabah</div>
    <div class="nav-item" onclick="showSection('rekening', event)">Rekening</div>
</div>

<div class="main">

    <!-- Dashboard -->
    <div id="dashboard" class="content-section active">
        <h2>Dashboard</h2>
        <p>Total Nasabah: <span id="totalNasabah"></span></p>
    </div>

    <!-- Nasabah -->
    <div id="nasabah" class="content-section">
        <h2>Data Nasabah</h2>
        <table>
            <thead>
                <tr>
                    <th>Nama</th>
                    <th>KTP</th>
                    <th>Status</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody id="nasabahTable"></tbody>
        </table>
    </div>

    <!-- Rekening -->
    <div id="rekening" class="content-section">
        <h2>Data Rekening</h2>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nama</th>
                    <th>Saldo</th>
                </tr>
            </thead>
            <tbody id="rekeningTable"></tbody>
        </table>
    </div>

</div>

<!-- Modal -->
<div id="modal" class="modal">
    <div class="modal-content">
        <h3>Detail Nasabah</h3>
        <div id="modalBody"></div>
        <br>
        <button onclick="closeModal()">Tutup</button>
    </div>
</div>

<script>

// DATA
const nasabahData = [
    {nama:'Budi', ktp:'123', status:'pending', saldo:500000},
    {nama:'Siti', ktp:'456', status:'approved', saldo:1000000}
];

// NAVIGATION
function showSection(section, event) {
    document.querySelectorAll('.content-section')
        .forEach(s => s.classList.remove('active'));

    document.querySelectorAll('.nav-item')
        .forEach(n => n.classList.remove('active'));

    document.getElementById(section).classList.add('active');
    event.target.classList.add('active');
}

// LOAD DATA
function loadData() {
    document.getElementById('totalNasabah').innerText = nasabahData.length;

    // Nasabah
    const nTable = document.getElementById('nasabahTable');
    nTable.innerHTML = '';
    nasabahData.forEach((n,i)=>{
        nTable.innerHTML += `
        <tr>
            <td>${n.nama}</td>
            <td>${n.ktp}</td>
            <td>${n.status}</td>
            <td>
                <button class="btn btn-primary" onclick="showDetail(${i})">Detail</button>
                ${n.status==='pending' ? `<button class="btn btn-success" onclick="approve(${i})">Approve</button>`:''}
            </td>
        </tr>`;
    });

    // Rekening
    const rTable = document.getElementById('rekeningTable');
    rTable.innerHTML = '';
    nasabahData.forEach(n=>{
        rTable.innerHTML += `
        <tr>
            <td>REK001</td>
            <td>${n.nama}</td>
            <td>${n.saldo}</td>
        </tr>`;
    });
}

// DETAIL
function showDetail(i) {
    const n = nasabahData[i];
    document.getElementById('modalBody').innerHTML = `
        Nama: ${n.nama}<br>
        KTP: ${n.ktp}<br>
        Status: ${n.status}<br>
        Saldo: ${n.saldo}
    `;
    document.getElementById('modal').style.display='block';
}

// CLOSE MODAL
function closeModal() {
    document.getElementById('modal').style.display='none';
}

// APPROVE
function approve(i) {
    nasabahData[i].status = 'approved';
    loadData();
}

// INIT
loadData();

</script>

</body>
</html>
